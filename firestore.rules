rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profil: region utama, mata uang, status notifikasi.
    match /users/{uid} {
      allow read, write: if owner(uid);
    }

    // Pantauan. lastPrice/lastMarket ditulis server (tools/price_alerts.py, Admin SDK).
    match /users/{uid}/watchlist/{productId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['title', 'image', 'addedAt', 'lastPrice', 'lastMarket'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 300;
    }

    // Token FCM perangkat.
    match /users/{uid}/tokens/{token} {
      allow read, write: if owner(uid);
    }
  }
}
